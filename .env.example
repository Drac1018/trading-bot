APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000
# Operational/service default: PostgreSQL
DATABASE_URL=postgresql+psycopg://trading_app:replace-with-strong-password@127.0.0.1:5432/trading_mvp
# Local single-process dev example:
# DATABASE_URL=sqlite:///./data/trading_mvp.db
# TRADING_MVP_ALLOW_SQLITE=1
REDIS_URL=redis://localhost:6379/0
DEFAULT_SYMBOL=BTCUSDT
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
DEFAULT_TIMEFRAME=15m
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ENV_ENABLED=false
MANUAL_LIVE_APPROVAL=false
TRADING_PAUSED=false
STARTING_EQUITY=100000
MAX_LEVERAGE=5
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05
MAX_CONSECUTIVE_LOSSES=3
STALE_MARKET_SECONDS=1800
SLIPPAGE_THRESHOLD_PCT=0.003
SCHEDULE_WINDOWS=1h,4h,12h,24h
MOCK_PROVIDER_ENABLED=true
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APP_SECRET_SEED=change-me-local-dev-secret
OPERATOR_API_KEY=
OPERATOR_VIEWER_API_KEY=
OPERATOR_TRADER_API_KEY=
OPERATOR_ADMIN_API_KEY=
OPERATOR_API_RATE_LIMIT_PER_MINUTE=600
OPERATOR_API_WRITE_RATE_LIMIT_PER_MINUTE=120
OPERATOR_AUTH_ENABLED=0
OPERATOR_UI_USERNAME=operator
# Productized guard: OPERATOR_UI_PASSWORD or FRONTEND_AUTH_PASSWORD must be at least 16 characters.
OPERATOR_UI_PASSWORD=
# Productized guard: use a dedicated session signing secret with at least 32 characters.
FRONTEND_AUTH_SECRET=
FRONTEND_AUTH_SESSION_TTL_SECONDS=43200
FRONTEND_AUTH_COOKIE_SECURE=0
FRONTEND_AUTH_MAX_FAILED_ATTEMPTS=5
FRONTEND_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AI_CALL_INTERVAL_MINUTES=30
DECISION_CYCLE_INTERVAL_MINUTES=15
AI_MAX_INPUT_CANDLES=32
AI_TEMPERATURE=0.1
BINANCE_MARKET_DATA_ENABLED=false
BINANCE_TESTNET_ENABLED=false
BINANCE_FUTURES_ENABLED=true
EXCHANGE_RECV_WINDOW_MS=5000
# Server-only target for Next /api proxy. Browser clients must call relative /api paths.
API_BASE_URL=http://127.0.0.1:8000
# Backend service default is loopback. Do not bind :8000 publicly unless a VPN/IP allowlist terminates access first.
TRADING_MVP_BACKEND_HOST=127.0.0.1
TRADING_MVP_ALLOW_PUBLIC_BACKEND_BIND=0
# Productization guard: set to 1 only when the operator UI is bound to loopback behind HTTPS reverse proxy + operator auth/IP allowlist.
OPERATOR_UI_BEHIND_TLS_PROXY=0
# Shared only between the HTTPS reverse proxy and the loopback Next service. Required before trusting X-Forwarded-* headers.
OPERATOR_UI_TRUSTED_PROXY_SECRET=
# Keep 0.0.0.0:3000 disabled by default. Set only for a private listener protected from direct public HTTP.
TRADING_MVP_ALLOW_PUBLIC_FRONTEND_BIND=0
OPERATOR_HTTPS_HOST=1.233.93.187.nip.io
